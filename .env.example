# IncuBrix AI Background Music Engine - Environment Configuration

# Service Configuration
ENV=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
SERVICE_NAME=incubrix-music-engine
API_PREFIX=/api/v1

# Music Provider: "synth" (built-in 4-stem multitrack), "mock" (lightning tests), "fluidsynth"
MUSIC_PROVIDER=synth
SEED_DEFAULT=42

# Storage Configuration ("local" or "s3")
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=./storage_data
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=incubrix-audio
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Audio Limits & Standards
MIN_DURATION_S=5.0
MAX_DURATION_S=300.0
DEFAULT_SAMPLE_RATE=48000
DEFAULT_TARGET_LUFS=-16.0
MAX_TRUE_PEAK_DBTP=-1.0

# SoundFont & FluidSynth paths
FLUIDSYNTH_BIN=C:\tools\fluidsynth\bin\fluidsynth.exe
SOUNDFONT_PATH=D:\ai background music\Video2Music\soundfonts\default_sound_font.sf2

# Webhook Callback Security
WEBHOOK_SECRET=incubrix_secret_key_demo
WEBHOOK_TIMEOUT_S=10.0

# Job Queue & Concurrency
MAX_CONCURRENT_JOBS=2
JOB_TIMEOUT_S=300
IDEMPOTENCY_EXPIRY_S=86400
